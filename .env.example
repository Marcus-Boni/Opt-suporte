# Copie para server/.env (é o arquivo que a API, as migrações e os scripts leem).

# ── Banco ────────────────────────────────────────────────────────────────
# Banco real: Azure Database for PostgreSQL (flexible server). TLS obrigatório e certificado verificado.
DATABASE_URL=postgresql://<usuario>:<senha>@<servidor>.postgres.database.azure.com:5432/<banco>?sslmode=require
# Banco local só para testar algo específico (docker compose sobe este Postgres em 127.0.0.1:5434):
# DATABASE_URL=postgres://optsolv:optsolv@127.0.0.1:5434/optsolv_experience
#
# Opcional: tamanho do pool por instância (padrão 10) e tempo máximo por consulta (padrão 30000 ms).
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
#
# Testes usam um banco irmão "<base>_test" recriado a cada execução; sempre o Postgres local.
# TEST_DATABASE_URL=postgres://optsolv:optsolv@127.0.0.1:5434/optsolv_experience

# ── API ──────────────────────────────────────────────────────────────────
PORT=4000
# Segredo para assinar cookies de sessão (32+ caracteres; obrigatório com NODE_ENV=production).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
# Proxies confiáveis na frente da API (1 no Azure Container Apps/App Service; 0 = acesso direto).
# Sem isso o IP real não chega e o limite de tentativas de login vale para todos juntos.
# TRUST_PROXY=1

# ── Web (build do Vite; variáveis em web/.env) ───────────────────────────
# Atalhos das contas demo no login aparecem só em `pnpm dev`. Para um ambiente de demonstração publicado:
# VITE_DEMO_LOGIN=true

# ── Login da equipe com Microsoft Entra ID (opcional; ver docs/ENTRA.md) ──
# Sem os três primeiros, todos entram com e-mail e senha.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:4000/api/v1/auth/entra/callback
# APP_URL=http://localhost:5173
# Com o Entra ligado, e-mails @optsolv.com.br só entram pela Microsoft, exceto estes (acesso de emergência):
# EMERGENCY_ADMIN_EMAILS=
# ENTRA_ALLOWED_DOMAINS=optsolv.com.br

# ── IA (Microsoft Foundry) ──────────────────────────────────────────────
# Autenticação Entra ID, sem chave: em dev usa o `az login`; em produção, identidade gerenciada (AZURE_CLIENT_ID se for atribuída pelo usuário).
# A identidade precisa do papel "Cognitive Services OpenAI User" na conta. Sem endpoint, a captura usa só regras locais. Ver docs/AI.md.
AZURE_OPENAI_ENDPOINT=https://<conta>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol
# AI_INTAKE_ENABLED=false
# AI_TIMEOUT_MS=30000

# ── MCP local (STDIO) e scripts ─────────────────────────────────────────
# Token de uma credencial criada em Acessos e API (só o hash fica no banco). Agentes remotos usam /api/v1/mcp com Bearer.
OPTSOLV_API_TOKEN=
# Teste de ponta a ponta (pnpm --filter server e2e): API alvo, só local salvo CONFIRM_DATABASE
# API_URL=http://localhost:4000
