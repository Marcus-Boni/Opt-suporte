# Copie para server/.env (é o arquivo que a API, as migrações e os scripts leem).

# ── Banco ────────────────────────────────────────────────────────────────
# Banco real: Azure Database for PostgreSQL (flexible server). TLS obrigatório e certificado verificado.
DATABASE_URL=postgresql://<usuario>:<senha>@<servidor>.postgres.database.azure.com:5432/<banco>?sslmode=require
# Banco local só para testar algo específico (docker compose sobe este Postgres em 127.0.0.1:5434):
# DATABASE_URL=postgres://optsolv:optsolv@127.0.0.1:5434/optsolv_experience
#
# Opcional: tamanho do pool por instância (padrão 10) e tempo máximo por consulta (padrão 30000 ms).
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
#
# Testes usam um banco irmão "<base>_test" recriado a cada execução; sempre o Postgres local.
# TEST_DATABASE_URL=postgres://optsolv:optsolv@127.0.0.1:5434/optsolv_experience

# ── API ──────────────────────────────────────────────────────────────────
PORT=4000
# Segredo para assinar cookies de sessão (32+ caracteres; obrigatório com NODE_ENV=production).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# ── MCP ──────────────────────────────────────────────────────────────────
# Token de uma credencial criada em Acessos e API (só o hash fica no banco)
OPTSOLV_API_TOKEN=
# URL da API usada pelo MCP
OPTSOLV_API_URL=http://localhost:4000
