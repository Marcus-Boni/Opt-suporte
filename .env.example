# ── Banco ────────────────────────────────────────────────────────────────
# Local (docker compose sobe este Postgres em 127.0.0.1:5434):
DATABASE_URL=postgres://optsolv:optsolv@127.0.0.1:5434/optsolv_experience
# Azure Database for PostgreSQL (flexible server): TLS obrigatório e certificado verificado.
# DATABASE_URL=postgresql://<usuario>:<senha>@<servidor>.postgres.database.azure.com:5432/<banco>?sslmode=require
#
# Opcional: URL com permissão de DDL só para as migrações (a aplicação usa um papel sem DDL). Ver docs/DATABASE.md.
# DATABASE_MIGRATION_URL=
# Opcional: tamanho do pool por instância (padrão 10) e tempo máximo por consulta (padrão 30000 ms).
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
#
# Testes usam um banco irmão "<base>_test" recriado a cada execução; por padrão o Postgres local.
# TEST_DATABASE_URL=postgres://optsolv:optsolv@127.0.0.1:5434/optsolv_experience

# ── API ──────────────────────────────────────────────────────────────────
PORT=4000
# Segredo para assinar cookies de sessão (32+ caracteres; obrigatório com NODE_ENV=production)
SESSION_SECRET=troque-este-segredo-local

# ── MCP ──────────────────────────────────────────────────────────────────
# Token do agente MCP (o seed local cria este; só o hash fica no banco)
OPTSOLV_API_TOKEN=osk_demo_agente_cidade_0000000000000000
# URL da API usada pelo MCP
OPTSOLV_API_URL=http://localhost:4000
