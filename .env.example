# Banco (docker compose sobe este Postgres em 127.0.0.1:5434)
DATABASE_URL=postgres://optsolv:optsolv@127.0.0.1:5434/optsolv_experience
# Porta da API
PORT=4000
# Segredo para assinar cookies de sessão (troque fora do ambiente local)
SESSION_SECRET=troque-este-segredo-local
# Pasta de anexos (relativa ao pacote server)
UPLOAD_DIR=./data/uploads
# Token do agente MCP (criado pelo seed; só o hash fica no banco)
OPTSOLV_API_TOKEN=osk_demo_agente_cidade_0000000000000000
# URL da API usada pelo MCP
OPTSOLV_API_URL=http://localhost:4000
