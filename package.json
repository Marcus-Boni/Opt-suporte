{
  "name": "optsolv-experience",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "db:reset": "pnpm --filter server db:reset",
    "mcp": "pnpm --filter server mcp",
    "test": "pnpm --filter server test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  }
}
