{
  "name": "server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "db:create-admin": "tsx src/db/create-admin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp:demo": "tsx scripts/mcp-demo.ts",
    "e2e": "tsx scripts/e2e.ts",
    "ai:eval": "tsx scripts/ai-eval.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^5.0.3",
    "openai": "^7.49.0",
    "openid-client": "^6.8.9",
    "pg": "^8.16.3",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "jose": "^6.2.15",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
